# Replace with your actual PostgreSQL database URL from Vercel
DATABASE_URL=""

# JWT secret for authentication
JWT_SECRET=""

# Yandex map api key
YA_MAPS_API_KEY=""

# AI engine for autofill: yandex | claude
AI_PROVIDER="claude"

# YandexGPT + Search API (autofill): API key of a service account with ai.languageModels.user and search-api.webSearch.user roles, and its folder id
YANDEX_GPT_API_KEY=""
YANDEX_FOLDER_ID=""

# Claude (AI_PROVIDER=claude). ANTHROPIC_MODEL is optional, defaults to claude-opus-5
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL=""
ANTHROPIC_MODEL=""

# Optional: Overpass API endpoint (OpenStreetMap) used by attractions auto-add. Defaults to https://overpass-api.de/api/interpreter
# Mirror example: https://overpass.kumi.systems/api/interpreter
OVERPASS_API_URL=""
